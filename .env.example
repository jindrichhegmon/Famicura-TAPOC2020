# /opt/famicura-tapo/.env na VPS (práva 600). Tajné hodnoty vyplňuje ./deploy/vps-env.sh,
# kamery ./deploy/vps-kamera.sh – ručně sem psát nemusíte.

# Heslo správce serveru: hlavní aplikace (kamery, nahrávky, nastavení) a
# nouzový vstup do dispečinku zvoleného tenanta. Dispečeři se přihlašují
# účtem Péče doma plus (JHN_APPS_TOKEN níže).
FAMICURA_PASSWORD=
# Podepisuje přihlašovací cookie; vygeneruje se na serveru a nikam necestuje.
SESSION_KEY=

# go2rtc (kamera → WebRTC) – běží vedle aplikace, API jen na localhostu
GO2RTC_URL=http://127.0.0.1:1984
# Veřejná IP VPS: na ni se prohlížeč připojuje pro obraz (port 8555)
PUBLIC_IP=95.216.201.2
# Názvy kamer "id=název; id=název" – spravuje ./deploy/vps-kamera.sh
CAMERA_NAMES=

# SMS rodině (pozvánky, žádosti o plný obraz) přes webhook Make: scénář
# Famicura_Tapo_SMS_Pozvanka (klíč, telefon, text) posílá SMS přes Twilio
# (stejné spojení jako JARVIS poslání SMS přes Twilio) a odpovídá {"ok":true}.
# Prázdné = SMS se ze serveru neposílá a dispečink pošle odkaz z vlastního
# telefonu. Vyplňuje ./deploy/vps-env.sh; ověří tlačítko Zkušební SMS v nastavení dispečinku.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KLIC=
# Veřejná adresa pro odkazy v SMS; prázdné = podle hlaviček od Caddy
PUBLIC_URL=
# Asistent v dispečinku přes webhook Make s AI (dostane klíč, otázku a text
# nápovědy, vrátí { "odpoved": "…" }). Prázdné = asistent odpovídá z nápovědy
# přímo v prohlížeči. Vyplňuje ./deploy/vps-env.sh.
ASISTENT_WEBHOOK_URL=
ASISTENT_WEBHOOK_KLIC=

# Databáze PeceDomaPlus (stejný SQL Server jako CLB1, login pecedomaplus_app,
# db_owner): tenanti (dbo.Tenants) a data každého poskytovatele v tabulkách
# A_KAM_* (zakládá server při startu, Row-Level Security podle IDTENANT).
# Bez hesla server běží jen pro ukázku bez tenantů. Vyplňuje ./deploy/vps-env.sh.
PDP_SQL_SERVER=
PDP_SQL_PORT=
PDP_SQL_DATABASE=PeceDomaPlus
PDP_SQL_USER=pecedomaplus_app
PDP_SQL_PASSWORD=
# Jen vývoj a ukázka bez SQL Serveru: tenanti a tabulky jen v paměti procesu,
# data po restartu zmizí ("ID=Název;ID2=Název2"). Na VPS nechte prázdné.
PDP_FAKE_TENANTS=

# Přihlášení dispečera účtem Péče doma plus: aplikace pecedomaplus-auth na
# aplikačním serveru jhn-apps (hlavička x-app-token = FAMICURA_REPORTY_TOKEN
# z /opt/jhn-apps/.env). Prázdný token = dispečink jen nouzovým heslem správce.
JHN_APPS_URL=https://95-216-201-2.sslip.io
JHN_APPS_TOKEN=

# SQL Server CLB1 – tabulky dbo.FamicuraRingLog a dbo.FamicuraRingNahravky (zakládá sql/clb1.sql).
# Stejné tabulky jako aplikace pro Ring; kamery se liší sloupcem KameraId.
# Aplikace do nich pouze zapisuje. Stejné hodnoty jako /opt/pecedoma-sestra/.env
SQL_SERVER=90.182.39.103
SQL_PORT=1433
SQL_DATABASE=CLB1
SQL_USER=clb1_app
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_CERT=true
SQL_TIMEOUT_MS=30000

# Server za Caddy
PORT=3112
HOST=127.0.0.1
TZ=Europe/Prague
